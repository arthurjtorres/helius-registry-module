# Variáveis do módulo de cadastro (registry). Só nomes, nunca valores reais.
# Obrigatórias: o container não sobe se faltar alguma (assertRequiredEnv lista os nomes ausentes).

# Porta desta API e da API de controle (integração)
PORT_API_CADASTRO=
PORT_API_CONTROLE=
# Opcional: URL completa do control (padrão http://modulo-controle:<PORT_API_CONTROLE>)
CONTROL_API_URL=

# Segredo do JWT (recomendado >= 32 caracteres)
JWT_SECRET=

# Banco de dados (Postgres)
DB_HOST=
DB_NAME=
DB_USER=
DB_PASS=

# CORS: origens pelas quais o portal é aberto, separadas por vírgula, sem barra final
# (ex.: http://<IP-da-VM>:1100). Exigida CORS_ORIGINS ou PORT_WEB_APP.
# Se CORS_ORIGINS estiver vazia, usa o fallback http://<DB_HOST>:<PORT_WEB_APP> e http://localhost:<PORT_WEB_APP>.
CORS_ORIGINS=
# Porta do portal web (front)
PORT_WEB_APP=
