# Ignorar todas as pastas node_modules e build em qualquer subdiretório
**/node_modules/
**/build/
**/dist/

# Saída compilada dentro de src/database/config (o build vai para build/).
# Não usar src/**/*.js: as migrations antigas são .js versionados.
src/database/config/*.js
src/database/config/*.d.ts

# Ignorar logs e arquivos temporários comuns
*.txt
*.lock
*.log
*.env
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Ignorar dependências do Docker
docker-compose.override.yml
.dockerignore

# Ignorar arquivos do VS Code
.vscode/

**.sh
#!entrypoint.sh
#!teste.txt